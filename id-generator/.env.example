# Dedicated PostgreSQL database for the standalone ID generator.
DATABASE_URL="postgresql://user:password@localhost:5432/freelance_id?schema=public"

# Auth.js session secret for admin login sessions.
AUTH_SECRET="replace-with-a-long-random-secret"

# Admin bootstrap credentials used only by the seed script in local/dev setup.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="replace-with-a-password-hash"
ADMIN_TOTP_SECRET="replace-with-a-totp-secret"

# Scan decision mode: demo auto-decides successful scans, review requires admin approval.
KYC_MODE="review"

# Default keeps selfie frames in-browser only. demo stores low-res thumbnails for 48h.
SELFIE_RETENTION_MODE="ephemeral"

# Email provider configuration. Use Resend by default, or SMTP_* values if switching providers.
RESEND_API_KEY="re_..."
EMAIL_FROM="Freelance ID Demo <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""

# Private S3-compatible object storage for generated card images and optional demo thumbnails.
S3_ENDPOINT="https://s3.example.com"
S3_REGION="auto"
S3_BUCKET="freelance-id-private"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"

# Main platform sync endpoint and protected transport. mTLS is intended for production.
MAIN_APP_SYNC_URL="https://main.example.com/api/v1/internal/freelance-identities"
MTLS_CLIENT_CERT_PATH=""
MTLS_CLIENT_KEY_PATH=""
MAIN_APP_SYNC_BEARER_TOKEN=""
