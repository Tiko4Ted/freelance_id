# Dedicated PostgreSQL database for the standalone ID generator.
DATABASE_URL="postgresql://user:password@localhost:5432/freelance_id?schema=public"

# Auth.js session secret for admin login sessions.
AUTH_SECRET="replace-with-a-long-random-secret"

# Public app origin used for emailed card download links.
APP_BASE_URL="https://id-generator.example.com"

# Admin bootstrap credentials used only by the seed script in local/dev setup.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="scrypt$replace-with-salt$replace-with-derived-key"
ADMIN_TOTP_SECRET="replace-with-a-totp-secret"

# Scan decision mode: demo auto-decides successful scans, review requires admin approval.
KYC_MODE="review"

# Default keeps selfie frames in-browser only. demo stores low-res thumbnails for 48h.
SELFIE_RETENTION_MODE="ephemeral"
NEXT_PUBLIC_SELFIE_RETENTION_MODE="ephemeral"

# Email provider configuration. Use Resend by default, or SMTP_* values if switching providers.
RESEND_API_KEY="re_..."
EMAIL_FROM="Freelance ID Demo <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""

# Private local filesystem storage for generated cards and optional demo thumbnails.
# Must be an absolute path outside id-generator/public/ and outside any static web root.
# On the VPS, create it for the app runtime user with chmod 700.
STORAGE_DRIVER="local"
STORAGE_ROOT_PATH="/var/lib/id-generator/storage"

# Temporary Vercel deployment storage. Set STORAGE_DRIVER=vercel-blob on Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Scheduler driver: node-cron for VPS/local watch mode, vercel-cron for Vercel Cron.
SCHEDULER_DRIVER="node-cron"
INTERNAL_CRON_SECRET="replace-with-a-long-random-secret"

# Main platform sync endpoint and protected transport. mTLS is intended for production.
MAIN_APP_SYNC_URL="https://main.example.com/api/v1/internal/freelance-identities"
MTLS_CLIENT_CERT_PATH=""
MTLS_CLIENT_KEY_PATH=""
MAIN_APP_SYNC_BEARER_TOKEN=""
